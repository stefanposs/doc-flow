# ============================================================
# DocFlow – Environment Variables Template
# ============================================================
# Copy to .env and adjust values:
#   cp .env.example .env
# ============================================================

# ─── Application ─────────────────────────────────────────────
DOCFLOW_ENV=development                # development | staging | production
DOCFLOW_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
DOCFLOW_LOG_FORMAT=text                # text | json
DOCFLOW_PORT=8000
DOCFLOW_WORKERS=4                      # uvicorn workers (production: 2*CPU+1)
DOCFLOW_MAX_FILE_SIZE_MB=100

# ─── Tika ────────────────────────────────────────────────────
DOCFLOW_TIKA_URL=http://localhost:9998
DOCFLOW_TIKA_TIMEOUT=120               # seconds

# ─── OCR (Tesseract) ────────────────────────────────────────
DOCFLOW_OCR_ENABLED=true
DOCFLOW_OCR_ENGINE=tesseract            # tesseract | google_vision | azure
DOCFLOW_OCR_LANGUAGE=deu
DOCFLOW_OCR_DPI=300

# ─── Storage ────────────────────────────────────────────────
DOCFLOW_STORAGE_BACKEND=local           # local | s3
DOCFLOW_STORAGE_PATH=/data/documents

# S3/MinIO (when DOCFLOW_STORAGE_BACKEND=s3)
# DOCFLOW_S3_ENDPOINT=http://localhost:9000
# DOCFLOW_S3_BUCKET=docflow-documents
# DOCFLOW_S3_ACCESS_KEY=
# DOCFLOW_S3_SECRET_KEY=
# DOCFLOW_S3_REGION=eu-central-1

# ─── Redis (optional) ───────────────────────────────────────
DOCFLOW_REDIS_URL=redis://localhost:6379/0
DOCFLOW_REDIS_ENABLED=false             # enable for job queue & caching

# ─── Processing Pipeline ────────────────────────────────────
DOCFLOW_DEFAULT_OUTPUT_FORMAT=markdown   # markdown | json | plaintext
DOCFLOW_DEFAULT_LANGUAGE=deu
DOCFLOW_PROCESSORS=cleanup,structure     # comma-separated list

# ─── LLM Post-Processing (optional) ─────────────────────────
# DOCFLOW_LLM_ENABLED=false
# DOCFLOW_LLM_PROVIDER=openai           # openai | ollama
# DOCFLOW_LLM_MODEL=gpt-4
# OPENAI_API_KEY=sk-...

# ─── Security ───────────────────────────────────────────────
# DOCFLOW_API_KEY=                       # API key for authentication (Phase 1)
# DOCFLOW_CORS_ORIGINS=http://localhost:3000

# ─── MinIO (Docker Compose only) ────────────────────────────
MINIO_ROOT_USER=docflow
MINIO_ROOT_PASSWORD=docflow-secret-change-me

# ─── Port Overrides (Docker Compose) ────────────────────────
# TIKA_PORT=9998
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
